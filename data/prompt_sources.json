{
  "schema_version": 1,
  "policy": {
    "allowed": [
      "official public documentation",
      "public repositories",
      "public release notes",
      "user-owned captures",
      "manual notes derived from observable product behavior"
    ],
    "not_allowed": [
      "private account secrets",
      "credentials",
      "unverified leaked private prompts",
      "content that cannot be cited or legally retained"
    ]
  },
  "agents": {
    "claude-code": {
      "snapshot_dir": "research/prompts/claude-code/versions",
      "changelog": "research/prompts/claude-code/CHANGELOG.md",
      "focus": ["system prompt", "tool instructions", "permission model", "release-to-release diff"]
    },
    "codex": {
      "snapshot_dir": "research/prompts/codex/versions",
      "changelog": "research/prompts/codex/CHANGELOG.md",
      "focus": ["system prompt", "tool contracts", "sandbox policy", "CLI behavior"]
    },
    "pi": {
      "snapshot_dir": "research/prompts/pi/versions",
      "changelog": "research/prompts/pi/CHANGELOG.md",
      "focus": ["conversation style", "memory cues", "safety behavior", "assistant persona"]
    },
    "opencode": {
      "snapshot_dir": "research/prompts/opencode/versions",
      "changelog": "research/prompts/opencode/CHANGELOG.md",
      "focus": ["repository prompts", "tool schemas", "agent loop", "model adapter behavior"]
    }
  }
}
