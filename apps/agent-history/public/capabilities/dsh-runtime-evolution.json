  "boundary": "固定源码差分与上游测试源码审读。未运行 DSH、上游测试、真实模型、基准或跨平台沙箱实验；本站来源校验和网页测试只验证材料与展示。所有自研伪代码和验收矩阵均为原创建议。",
  "unknowns": [
    {
      "id": "DRE-KU-01",
      "title": "1017 模型与 Harness 各贡献多少收益",
      "text": "训练期适配有官方声明，未找到固定同一模型、只切换 Harness 版本的公开消融。",
      "needed": "固定模型、任务、预算、配置和随机种子，对比成功率、时间、输出与调用成本。"
    },
    {
      "id": "DRE-KU-02",
      "title": "取消与权限竞态的实际覆盖",
      "text": "测试源码描述了失效和收尾规则，但本次没有执行竞态、攻击或跨平台实验。",
      "needed": "受控环境中交错策略切换、工具更新、进程退出与下一轮准入，记录全部事件与副作用。"
    },
    {
      "id": "DRE-KU-03",
      "title": "文件沙箱之外的隔离范围",
      "text": "Node 执行环境与工具授权不等于所有网络、系统资源和第三方工具都已隔离。",
      "needed": "明确 OS、运行账号、网络策略和 provider，在无生产凭据环境验证实际可达范围。"
    },
    {
      "id": "DRE-KU-04",
      "title": "进程重启后的工作恢复",
      "text": "in-memory 状态不是 durable checkpoint；收尾测试不证明突然断电或根上下文并发销毁无损。",
      "needed": "分别测试进程崩溃、写入未完成、持久化失败和完整恢复，核对日志与外部现实。"
    },
    {
      "id": "DRE-KU-05",
      "title": "不合作的第三方工具如何收尾",
      "text": "忽略取消的工具或已经接受请求的外部服务，不会被一个 abort 自动撤销。",
      "needed": "注入不返回和回执丢失，验证截止条件、幂等键、未知结果记录与 readback。"
    },
    {
      "id": "DRE-KU-06",
      "title": "持久状态与稳定前缀的实际成本",
      "text": "源码解释了复用与前缀稳定性，但未量化内存、缓存命中、重复声明错误和长任务成本。",
      "needed": "按 per-call/persistent、任务长度和插件规模分组采集性能与失败分布。"
    }
  ],
