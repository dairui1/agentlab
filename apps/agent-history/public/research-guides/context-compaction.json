                    "label": "活跃历史",
                    "status": "active"
                  },
                  {
                    "label": "90% 自动边界",
                    "status": "idle"
                  },
                  {
                    "label": "95% 硬边界",
                    "status": "idle"
                  }
                ],
                "panels": [
