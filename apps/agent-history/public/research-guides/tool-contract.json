    {
      "id": "timeout",
      "title": "等到超时，三个 Shell 会回什么？",
      "lead": "同样叫 timeout，固定产品的收尾方式不同。",
      "body": [
        "这里仅比较内建命令。Claude foreground Bash 可转后台；Codex shell 归一为 exit 124；opencode Shell 可用 completed、exit:null 和输出中的原因收尾。",
        "MCP 超时是另一条合同，不能借 Bash 的行为解释它。"
      ],
      "model": {
        "id": "timeout-model",
        "kind": "compare",
        "title": "等待结束，任务怎样收尾",
        "controls": [
          {
            "id": "product",
            "label": "内建命令路径",
            "type": "select",
            "default": "claude",
            "options": [
              {
                "value": "claude",
                "label": "Claude foreground Bash"
              },
              {
                "value": "codex",
                "label": "Codex shell"
              },
              {
                "value": "opencode",
                "label": "opencode Shell"
              }
            ]
          }
        ],
        "cases": [
          {
            "when": {
              "product": "claude"
            },
            "label": "前台返回，后台继续",
            "explanation": "返回 task ID 和 output path 后，任务仍可继续，随后才有完成通知。",
            "frames": [
              {
                "caption": "timeout 转成 background transition",
                "diagram": [
                  {
                    "label": "前台调用",
                    "status": "done"
                  },
                  {
                    "label": "后台任务",
                    "status": "active"
                  },
                  {
                    "label": "完成通知",
                    "status": "idle"
                  }
                ],
                "panels": [
                  {
                    "title": "即时回执",
                    "items": [
                      {
                        "label": "foreground",
                        "value": "已返回",
                        "state": "done"
                      },
                      {
                        "label": "句柄",
                        "value": "task ID + output path"
                      }
                    ]
                  },
                  {
                    "title": "任务",
                    "items": [
                      {
                        "label": "状态",
                        "value": "running in background",
                        "state": "active"
                      },
                      {
                        "label": "下一步",
                        "value": "跟踪已有 task，不因 timeout 重复启动"
                      }
                    ]
                  }
                ],
                "log": [
                  "等待结束不等于任务被 kill。"
                ]
              }
            ]
          },
          {
            "when": {
              "product": "codex"
            },
            "label": "命令以 timeout 失败收尾",
            "explanation": "固定 shell 输出保留已收集文本，timeout 归一成 exit 124。",
            "frames": [
