    {
      "id": "revision",
      "title": "批准之后，工具定义变了怎么办？",
      "lead": "Codex 的 PreparedMcpCall 会检查 catalog revision。",
      "body": [
        "把准备调用时的定义和 client handle 绑定起来，避免批准的是旧工具，执行的却是另一份新定义。",
        "opencode 的 list-change refresh 是另一套路径：刷新失败会保留旧 defs，成功才替换；下一 provider step 又重新解析工具。"
      ],
      "model": {
        "id": "revision-model",
        "kind": "compare",
        "title": "Codex：冻结的调用与当前目录",
        "controls": [
          {
            "id": "changed",
            "label": "prepare 后 catalog revision 改变",
            "type": "toggle",
            "default": false
          }
        ],
        "cases": [
          {
            "when": {
              "changed": false
            },
            "label": "准备时与执行时的目录一致",
            "explanation": "exact binding 仍对应同一 catalog 和 client handles。",
            "frames": [
              {
                "caption": "revision 一致",
                "diagram": [
                  {
                    "label": "PreparedMcpCall",
                    "status": "done"
                  },
