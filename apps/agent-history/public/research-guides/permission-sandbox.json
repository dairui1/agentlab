                "label": "命中 deny"
              },
              {
                "value": "undecided",
                "label": "尚未决议"
              }
            ]
          },
          {
            "id": "mode",
            "label": "模式",
            "type": "select",
            "default": "bypass",
            "options": [
              {
                "value": "bypass",
                "label": "bypassPermissions"
              },
              {
                "value": "default",
                "label": "default"
              }
            ]
          }
        ],
        "cases": [
          {
            "when": {
              "rule": "deny"
            },
            "label": "deny 先短路",
            "explanation": "后面的 bypass 或 callback 不能救回这条 deny。场景不注入其他 hook 改写。",
            "frames": [
              {
                "caption": "调用进入权限链",
                "diagram": [
