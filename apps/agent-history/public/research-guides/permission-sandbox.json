                    "items": [
                      {
                        "label": "mode",
                        "value": "{{mode}}"
                      },
                      {
                        "label": "callback",
                        "value": "尚未到达"
                      }
                    ]
                  }
                ],
                "log": [
                  "PreToolUse 位于这条规则判断之前。"
                ]
              },
              {
                "caption": "规则命中 deny",
                "diagram": [
                  {
                    "label": "deny",
                    "status": "blocked"
                  },
                  {
                    "label": "mode",
                    "status": "idle"
                  }
                ],
                "panels": [
                  {
                    "title": "提案",
