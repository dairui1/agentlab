                  },
                  {
                    "title": "后续层",
                    "items": [
                      {
                        "label": "mode",
                        "value": "不能覆盖已有 deny",
                        "state": "idle"
                      },
                      {
                        "label": "callback",
                        "value": "不处理已决议调用",
                        "state": "idle"
                      }
                    ]
                  }
                ],
                "log": [
                  "这不是 allow 和 deny 的票数比较。"
                ]
              },
              {
                "caption": "拒绝收口",
                "diagram": [
                  {
                    "label": "工具执行",
                    "status": "blocked"
                  },
                  {
                    "label": "callback",
                    "status": "idle"
