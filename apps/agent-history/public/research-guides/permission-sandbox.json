{
  "id": "permission-sandbox",
  "title": "权限、审批与沙箱",
  "subtitle": "你点了允许，为什么还是写不了文件？反过来，不弹窗又代表什么？",
  "intro": [
    "Agent 要把生成的文件写入工作区。需要审批时先得到决策，再沿有效路径规则进入工具执行，最后读取结果。",
    "先让两项准入都满足，再分别关闭它们。这样能看出审批与执行范围分别负责哪一部分。"
  ],
  "versionNote": "固定资料：Claude Code 2.1.226、Codex 0.147.0、opencode V1 1.18.15，核验日 2026-08-10。跨平台 enforcement 不由这些教学模型验证。",
  "source": {
    "label": "固定版本权限证据",
    "href": "/dossiers/permission-sandbox-evidence.json",
    "boundary": "所有准入与拒绝都是教学假定，不改变真实权限、不运行命令，也不提供沙箱安全保证。"
  },
  "chapters": [
    {
      "id": "two-gates",
      "title": "先让一次写入通过两道门",
      "lead": "Codex 的 approval policy 与 runtime sandbox 配合决定准入。",
      "body": [
        "这里假定目标是工作区中的文件，且有效规则已明确。默认两道门都允许；逐项关闭，看工具在哪一站停下。"
      ],
      "model": {
        "id": "two-gates-model",
        "kind": "compare",
        "title": "Codex：审批与路径边界",
        "controls": [
          {
            "id": "approved",
            "label": "提案已获批准",
            "type": "toggle",
            "default": true
          },
          {
            "id": "path",
            "label": "有效路径规则允许目标",
            "type": "toggle",
            "default": true
          }
        ],
        "cases": [
          {
            "when": {
              "approved": false
            },
            "label": "审批门未放行",
            "explanation": "即使路径规则允许，也不能从文件可写推出提案已获批准。 提案与文件内容为场景示例，准入满足时才可进入写入。",
            "frames": [
              {
                "caption": "停在准入阶段",
                "diagram": [
                  {
                    "label": "审批",
                    "status": "blocked"
                  },
                  {
                    "label": "路径规则",
                    "status": "idle"
                  },
                  {
                    "label": "执行",
                    "status": "idle"
                  }
                ],
                "panels": [
                  {
                    "title": "审批",
                    "items": [
                      {
                        "label": "提案",
                        "value": "未获批准",
                        "state": "blocked"
                      },
                      {
                        "label": "提案",
                        "value": "修改项目 src/login.ts 的空密码分支。"
                      },
                      {
                        "label": "计划内容",
                        "value": "把空密码返回值由 ok:true 改为 ok:false。"
                      }
                    ]
                  },
                  {
                    "title": "执行边界",
                    "items": [
                      {
                        "label": "目标规则开关",
                        "value": "{{path}}"
                      },
                      {
                        "label": "实际写入",
                        "value": "本场景未进入执行",
                        "state": "idle"
                      },
                      {
                        "label": "项目根",
                        "value": "/demo-app（示例项目）"
                      },
                      {
                        "label": "目标",
                        "value": "/demo-app/src/login.ts"
                      },
                      {
                        "label": "当前内容",
                        "value": "空密码仍返回 ok:true；写入尚待工具执行。",
                        "state": "idle"
                      }
                    ]
                  }
                ],
                "log": [
                  "路径权限不能替代批准。"
                ]
              }
            ]
          },
          {
            "when": {
              "approved": true,
              "path": false
            },
            "label": "批准了提案，边界仍不允许",
            "explanation": "普通 approval resolution 不等于把任意路径或网络加入 grant；额外权限需要相应提案与 host 决策。 提案与文件内容为场景示例，准入满足时才可进入写入。",
            "frames": [
              {
                "caption": "两道门给出不同答案",
                "diagram": [
                  {
                    "label": "审批",
                    "status": "done"
                  },
                  {
                    "label": "路径规则",
                    "status": "blocked"
                  },
                  {
                    "label": "额外权限提案",
                    "status": "unknown"
                  }
                ],
                "panels": [
                  {
                    "title": "审批",
                    "items": [
                      {
                        "label": "提案",
                        "value": "已批准",
                        "state": "done"
                      },
                      {
                        "label": "执行完成",
                        "value": "尚无回执",
                        "state": "unknown"
                      },
                      {
                        "label": "提案",
                        "value": "修改项目 src/login.ts 的空密码分支。"
                      },
                      {
                        "label": "计划内容",
                        "value": "把空密码返回值由 ok:true 改为 ok:false。"
                      }
                    ]
                  },
                  {
                    "title": "执行边界",
                    "items": [
                      {
                        "label": "目标路径",
                        "value": "有效规则不允许",
                        "state": "blocked"
                      },
                      {
                        "label": "下一步",
                        "value": "改路径，或提出受支持的额外权限申请"
                      },
                      {
                        "label": "项目根",
                        "value": "/demo-app（示例项目）"
                      },
                      {
                        "label": "目标",
                        "value": "/demo-app/src/login.ts"
                      },
                      {
                        "label": "当前内容",
                        "value": "空密码仍返回 ok:true；写入尚待工具执行。",
                        "state": "idle"
                      }
                    ]
                  }
                ],
                "log": [
                  "filesystem grant 也不会顺手授予 network。"
                ]
              }
            ]
          },
          {
            "when": {},
            "label": "两道准入条件都满足",
            "explanation": "这里只得出可以进入相应执行路径；工具成功、文件正确和跨平台隔离仍需要各自证据。 提案与文件内容为场景示例，准入满足时才可进入写入。",
            "frames": [
              {
                "caption": "准入满足，进入工具执行",
                "diagram": [
                  {
                    "label": "审批",
                    "status": "done"
                  },
                  {
                    "label": "路径规则",
                    "status": "done"
                  },
                  {
                    "label": "工具执行",
                    "status": "active"
                  }
                ],
                "panels": [
                  {
                    "title": "审批",
                    "items": [
                      {
                        "label": "提案",
                        "value": "已批准",
                        "state": "done"
                      },
                      {
                        "label": "提案",
                        "value": "修改项目 src/login.ts 的空密码分支。"
                      },
                      {
                        "label": "计划内容",
                        "value": "把空密码返回值由 ok:true 改为 ok:false。"
                      }
                    ]
                  },
                  {
                    "title": "执行边界",
                    "items": [
                      {
                        "label": "目标路径",
                        "value": "允许进入执行路径",
                        "state": "done"
                      },
                      {
                        "label": "下一步",
                        "value": "执行工具后读取 commandExecution terminal",
                        "state": "active"
                      },
                      {
                        "label": "项目根",
                        "value": "/demo-app（示例项目）"
                      },
                      {
                        "label": "目标",
                        "value": "/demo-app/src/login.ts"
                      },
                      {
                        "label": "当前内容",
                        "value": "空密码仍返回 ok:true；写入尚待工具执行。",
                        "state": "idle"
                      }
                    ]
                  }
                ],
                "log": [
                  "审批回执与 commandExecution terminal 分开。"
                ]
              }
            ]
          }
        ],
        "evidence": [
          "PERM-CX-01",
          "PERM-CX-06",
          "PERM-CX-08",
          "PERM-CX-10"
        ]
      },
      "takeaway": "批准提案不等于改写整个执行环境。"
    },
    {
      "id": "scene",
      "title": "看得见工具，也可能用不了",
      "lead": "目录里有一个工具，不代表这次调用已经获准。",
      "body": [
        "工具可见性、规则决策、人类审批和 OS enforcement 是不同层。把它们压成一个绿色‘允许’，出错时就不知道卡在哪道门。",
        "批准也不是执行完成。需要等工具终态，再检查文件或外部对象的结果；取消批准不能自动撤销已经发生的副作用。"
      ],
      "takeaway": "先定位哪一层的允许，再讨论它允许了什么。"
    },
    {
      "id": "short-circuit",
      "title": "开了 bypass，前面的 deny 还能拦住吗？",
      "lead": "Claude 的固定合同按阶段短路，不是所有规则一起投票。",
      "body": [
        "前面的 hook 或声明式 deny 先得出结果，后面的 mode 和 callback 不会把它翻成 allow。canUseTool 只接住此前仍未决的调用。"
      ],
      "model": {
        "id": "short-circuit-model",
        "kind": "timeline",
        "title": "Claude：先有规则，再有 mode",
        "controls": [
