    {
      "id": "verify",
      "title": "点击送达了，保存就一定成功了吗？",
      "lead": "Cua Driver 把动作事实与业务条件分开返回。",
      "body": [
        "ActionResult 报 effect、route、delivery 与有限 evidence。verify_state 另查调用方定义的业务条件：satisfied、unsatisfied 或 unknown。",
        "把这两份结果并排看，就不会因为出现一个光标动画，或一次 action confirmed，就提前宣布文件保存成功。"
      ],
      "model": {
        "id": "verify-model",
        "kind": "compare",
        "title": "Cua Driver：动作事实与业务回看",
        "controls": [
          {
            "id": "effect",
            "label": "动作结果 effect",
            "type": "select",
            "default": "confirmed",
            "options": [
              {
                "value": "confirmed",
                "label": "confirmed"
              },
              {
                "value": "unverifiable",
                "label": "unverifiable"
              }
            ]
          },
          {
            "id": "business",
            "label": "独立保存条件验证",
            "type": "select",
            "default": "satisfied",
            "options": [
              {
                "value": "satisfied",
                "label": "满足"
              },
              {
                "value": "unsatisfied",
                "label": "不满足"
              },
              {
                "value": "unknown",
                "label": "无法判定"
              }
            ]
          }
        ],
        "cases": [
          {
            "when": {
              "business": "satisfied"
            },
            "label": "独立回看满足保存条件",
            "explanation": "业务结论来自 verify_state，而不是把 action effect 改名成任务成功。",
