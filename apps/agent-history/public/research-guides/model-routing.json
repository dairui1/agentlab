    {
      "id": "scene",
      "title": "模型名字只是开始",
      "lead": "同一个名字，还需要配得上当前的能力资料。",
      "body": [
        "工具 schema、输入类型、上下文窗口和 reasoning effort 都与目标模型有关。换名字之后继续沿用旧能力，可能连请求形状都不再合适。",
        "最后一条回复的模型也不是完整成本账本。重试、子助手和辅助请求可能各有一次请求与用量；缺少这些回执时，费用应标未知。"
      ],
      "takeaway": "记录每次请求的实际路由，不从最后一句回复倒推。"
    },
    {
      "id": "fallback",
      "title": "‘回退’到底改了哪一格？",
      "lead": "下面是 Codex 中三条不同路径的独立示意，不是一条串起来的 failover 链。",
      "body": [
        "静态 provider 的启动选择替换可以换模型；陌生 slug 的 metadata fallback 保留原 slug；transport fallback 则改变通道。"
      ],
      "model": {
        "id": "fallback-model",
        "kind": "compare",
        "title": "Codex：三种 fallback",
        "controls": [
          {
            "id": "fallback",
            "label": "发生的路径",
            "type": "select",
            "default": "selection",
            "options": [
              {
                "value": "selection",
                "label": "静态 provider 启动选择替换"
              },
              {
                "value": "metadata",
                "label": "未知 slug 的能力资料回退"
              },
              {
                "value": "transport",
                "label": "WebSocket 改走 HTTPS"
              }
            ]
          }
        ],
        "cases": [
          {
            "when": {
              "fallback": "selection"
            },
            "label": "模型值确实改变",
            "explanation": "场景假定权威 static catalog 没有请求模型，且 allowProviderModelFallback 已启用。",
            "frames": [
              {
                "caption": "启动阶段改为 provider default",
                "diagram": [
                  {
                    "label": "请求模型",
                    "status": "idle"
                  },
