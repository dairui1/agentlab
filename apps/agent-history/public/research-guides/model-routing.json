                        "label": "effective",
                        "value": "provider-default",
                        "state": "active"
                      }
                    ]
                  },
                  {
                    "title": "能力与传输",
                    "items": [
                      {
                        "label": "能力",
                        "value": "要按实际模型重新核对"
                      },
                      {
                        "label": "通道",
                        "value": "不因这个选择自动改变"
                      }
                    ]
                  }
                ],
                "log": [
                  "启动选择替换不是运行中容量回退。"
