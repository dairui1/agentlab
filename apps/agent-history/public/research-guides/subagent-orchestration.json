    {
      "id": "context-files",
      "title": "没看父对话，为什么还能改到父文件？",
      "lead": "在 Claude 的这条合同里，fresh/fork 与 worktree 是两根独立的轴。",
      "body": [
        "fresh 让子助手从新对话开始；fork 复制父历史。worktree 改变 checkout，既不会替 fresh 补历史，也不会替 fork 清掉历史。"
      ],
      "model": {
        "id": "context-files-model",
        "kind": "compare",
        "title": "Claude：对话与文件分别选择",
        "controls": [
          {
            "id": "context",
            "label": "子对话",
            "type": "select",
            "default": "fresh",
            "options": [
              {
                "value": "fresh",
                "label": "新对话"
              },
              {
                "value": "fork",
                "label": "复制父历史"
              }
