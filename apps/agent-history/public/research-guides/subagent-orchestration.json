          },
          {
            "id": "files",
            "label": "文件工作面",
            "type": "select",
            "default": "worktree",
            "options": [
              {
                "value": "shared",
                "label": "共享 checkout"
              },
              {
                "value": "worktree",
                "label": "独立 worktree"
              }
            ]
          }
        ],
        "cases": [
          {
            "when": {
              "context": "fresh",
              "files": "shared"
            },
            "label": "新对话，共享文件",
            "explanation": "它不知道父对话的细节，却能看到当前工作面的文件改动。",
