{
  "id": "subagent-orchestration",
  "title": "Sub-agent 编排",
  "subtitle": "把两件事交给两个助手之后，谁看见什么，谁在改文件，谁还在等？",
  "intro": [
    "你把接口调查交给一个助手，把实现交给另一个。它们各自完成任务，再把结果送回主助手，主助手检查并汇合产物。",
    "先走一遍派工与回报。随后再改变消息方式、历史来源和文件工作面，看哪一层跟着变化。"
  ],
  "versionNote": "固定资料：Claude Code 2.1.226、Codex 0.147.0、opencode V1 1.18.15，核验日 2026-08-10。Claude 的文档合同与构建捕获按原证据分别标注，不外推到当前版本。",
  "source": {
    "label": "固定版本编排证据",
    "href": "/dossiers/subagent-evidence.json",
    "boundary": "下面只模拟资料中的控制合同，不创建真实 Agent、不修改工作区，也不测试并发性能。"
  },
  "chapters": [
    {
      "id": "mailbox",
      "title": "先派工，再收到回报",
      "lead": "Codex 给已有助手补一个任务，先启动工作，最后通过结果通道回报。",
      "body": [
        "followup_task 会在目标 idle 时启动一轮；目标运行中则等可投递的边界。正常路径里，子助手完成后，final answer 异步回到主助手。",
        "把发送方式切成 send_message：消息仍能投递，却不会仅凭这次调用启动空闲目标。"
      ],
      "model": {
        "id": "mailbox-model",
        "kind": "timeline",
        "title": "Codex：发消息与启动工作",
        "controls": [
          {
            "id": "delivery",
            "label": "发送方式",
            "type": "select",
            "default": "followup",
            "options": [
              {
                "value": "message",
                "label": "send_message"
              },
              {
                "value": "followup",
                "label": "followup_task"
              }
            ]
          },
          {
            "id": "initial",
            "label": "目标状态",
            "type": "select",
            "default": "idle",
            "options": [
              {
                "value": "idle",
                "label": "空闲"
              },
              {
                "value": "running",
                "label": "正在运行"
              }
            ]
          }
        ],
        "cases": [
          {
            "when": {
              "initial": "idle",
              "delivery": "message"
            },
            "label": "投递后仍然空闲",
            "explanation": "没有新 turn 被启动，不能把投递回执当成执行回执。",
            "frames": [
              {
                "caption": "发送前",
                "diagram": [
                  {
                    "label": "父助手",
                    "status": "active"
                  },
                  {
                    "label": "mailbox",
                    "status": "idle"
                  },
                  {
                    "label": "子助手",
                    "status": "idle"
                  }
                ],
                "panels": [
                  {
                    "title": "消息",
                    "items": [
                      {
                        "label": "状态",
                        "value": "未投递"
