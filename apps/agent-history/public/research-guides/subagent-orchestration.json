                        "value": "不在直接结果里",
                        "state": "idle"
                      }
                    ]
                  }
                ],
                "log": [
                  "Session continuation 不是编排 checkpoint replay。"
                ]
              }
            ]
          },
          {
            "when": {},
            "label": "调用成功，却是新子会话",
            "explanation": "lookup failure 被转成 undefined，之后走 fresh child 路径。旧工作的完整恢复不能从这个成功结果推出。",
            "frames": [
              {
                "caption": "失效句柄没有拦住创建",
                "diagram": [
                  {
                    "label": "task_id 查询",
                    "status": "blocked"
